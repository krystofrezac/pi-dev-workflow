{
	"name": "pi-dev-workflow",
	"version": "0.1.0",
	"description": "A plan → build workflow for pi (/dev) run by four agents: Planner, Plan reviewer, Developer and Code reviewer.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check --error-on-warnings .",
		"test": "node --test \"*.test.ts\"",
		"e2e": "sh e2e/run.sh",
		"check": "npm run typecheck && npm run lint && npm run test && npm run e2e"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@earendil-works/pi-tui": "1.4.0",
		"@types/node": "24.19.2",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	}
}
