{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["*.ts", "prompts/*.ts", "e2e/*.ts"]
}
